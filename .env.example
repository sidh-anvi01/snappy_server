PORT=5000
JWT_SECRET_KEY=replace-with-a-long-random-secret
MONGODB_URI=mongodb://127.0.0.1:27017/snappy

# Set these on the backend host and use the same secret with coturn.
TURN_REALM=turn.example.com
TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp
TURN_SECRET=replace-with-a-random-secret-shared-with-coturn
